{
  "name": "discord-mana-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @discord-mana/playground dev",
    "build": "pnpm --filter discord-mana... build",
    "build:sites": "pnpm --filter @discord-mana/playground --filter @discord-mana/preview --filter @discord-mana/site --filter @discord-mana/builder-site build",
    "deploy:playground": "pnpm --filter @discord-mana/playground run deploy",
    "deploy:preview": "pnpm --filter @discord-mana/preview run deploy",
    "deploy:site": "pnpm --filter @discord-mana/site run deploy",
    "deploy:builder": "pnpm --filter @discord-mana/builder-site run deploy",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @discord-mana/preview typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "assets:split": "node scripts/split-modules.mjs",
    "assets:css": "node scripts/extract-css.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.10",
    "acorn": "^8.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  }
}

{
  "name": "@discord-mana/icons",
  "version": "1.0.0",
  "description": "Discord's icons as React components, for discord-mana.",
  "keywords": [
    "discord",
    "mana",
    "icons",
    "react",
    "svg"
  ],
  "license": "MIT",
  "homepage": "https://discord-mana.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darker-Ink/discord-components.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "react": "^19",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }

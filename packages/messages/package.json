{
  "name": "@discord-mana/messages",
  "version": "1.0.0",
  "description": "React components that render Discord messages: embeds, attachments, media and Components v2.",
  "keywords": [
    "discord",
    "mana",
    "react",
    "messages",
    "embeds",
    "components-v2"
  ],
  "license": "MIT",
  "homepage": "https://discord-mana.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darker-Ink/discord-components.git",
    "directory": "packages/messages"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@discord-mana/components": "workspace:*",
    "@discord-mana/icons": "workspace:*",
    "@discord-mana/tokens": "workspace:*",
    "@react-spring/web": "^10.1.2",
    "clsx": "^2.1.1",
    "react-focus-rings": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "react": "^19",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    }
  }
}

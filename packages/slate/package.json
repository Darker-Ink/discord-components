{
  "name": "@discord-mana/slate",
  "version": "0.0.0",
  "description": "Discord's chat input for React: the Slate rich text editor with live markdown, mentions and emoji.",
  "keywords": [
    "discord",
    "mana",
    "react",
    "slate",
    "editor",
    "chat-input"
  ],
  "license": "MIT",
  "homepage": "https://discord-mana.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darker-Ink/discord-components.git",
    "directory": "packages/slate"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@discord-mana/components": "workspace:*",
    "@discord-mana/icons": "workspace:*",
    "@discord-mana/markdown": "workspace:*",
    "@discord-mana/messages": "workspace:*",
    "@discord-mana/tokens": "workspace:*",
    "@juggle/resize-observer": "3.4.0",
    "@react-spring/web": "^10.1.2",
    "clsx": "^2.1.1",
    "direction": "1.0.4",
    "is-hotkey": "0.2.0",
    "is-plain-object": "5.0.0",
    "lodash": "4.17.21",
    "lottie-web": "5.12.2",
    "scroll-into-view-if-needed": "2.2.31",
    "slate": "0.91.4",
    "tiny-invariant": "1.0.6"
  },
  "devDependencies": {
    "@types/is-hotkey": "0.1.10",
    "@types/lodash": "4.17.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "react": "^19",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    }
  }
}

{
  "name": "@discord-mana/components",
  "version": "0.0.0",
  "description": "React recreations of Discord's Mana design system components.",
  "keywords": [
    "discord",
    "mana",
    "design-system",
    "react",
    "components",
    "ui"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darker-Ink/discord-components.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build"
  },
  "dependencies": {
    "@discord-mana/icons": "workspace:*",
    "@discord-mana/tokens": "workspace:*",
    "@floating-ui/react": "^0.27.20",
    "@floating-ui/react-dom": "^2.1.9",
    "@internationalized/date": "3.12.4",
    "@react-spring/web": "^10.1.2",
    "@rive-app/canvas": "2.40.0",
    "@rive-app/react-canvas": "4.32.0",
    "chroma-js": "2.4.2",
    "clsx": "^2.1.1",
    "colorjs.io": "0.5.2",
    "focus-layers": "^0.6.1",
    "lottie-web": "5.12.2",
    "match-sorter": "6.3.4",
    "moment": "2.31.0",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "react-color": "2.19.3",
    "react-focus-rings": "^1.3.0",
    "react-stately": "3.51.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/chroma-js": "2.4.4",
    "@types/react": "^19.3.3",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "^19.3.0",
    "react": "^19",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    }
  }
}
